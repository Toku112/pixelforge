#version 440
// B4: per-pixel grade. Same maths as spike::cpuGrade.
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba32f) uniform writeonly image2D dst;
layout(std140, binding = 2) uniform Params { vec4 m0; vec4 m1; vec4 m2; vec4 eggg; };  // exposure, gain, offset, gamma

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec4 c = texelFetch(src, p, 0);
    vec3 e = c.rgb * eggg.x;
    vec3 g = vec3(dot(m0.xyz, e), dot(m1.xyz, e), dot(m2.xyz, e)) * eggg.y + eggg.z;
    vec3 o = sign(g) * pow(abs(g), vec3(eggg.w));
    imageStore(dst, p, vec4(o, c.a));
}
