{
  "name": "pixelforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm wasm:ensure && vite",
    "build": "pnpm wasm && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm wasm:ensure && tsc -p tsconfig.core.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0 && prettier --check . && pnpm lint:rust && pnpm check:licenses",
    "lint:rust": "cd src/wasm && cargo fmt --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo clippy --workspace --target wasm32-unknown-unknown -- -D warnings",
    "check:licenses": "node scripts/check-licenses.ts",
    "format": "eslint . --fix && prettier --write .",
    "test": "pnpm wasm:ensure && vitest run",
    "test:watch": "pnpm wasm:ensure && vitest",
    "test:golden": "pnpm wasm:ensure && vitest run --project golden",
    "test:golden:update": "pnpm wasm:ensure && UPDATE_GOLDEN=1 vitest run --project golden",
    "test:e2e": "pnpm wasm:ensure && playwright test",
    "test:e2e:all": "pnpm wasm:ensure && PW_ALL_BROWSERS=1 playwright test",
    "test:e2e:preview": "PW_PREVIEW=1 playwright test",
    "test:perf": "pnpm wasm:ensure && PW_PERF=1 playwright test",
    "test:rust": "cd src/wasm && cargo test --workspace && cargo test --workspace --all-features",
    "wasm": "node scripts/build-wasm.ts",
    "wasm:ensure": "node scripts/build-wasm.ts --if-stale",
    "prepare": "husky"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
