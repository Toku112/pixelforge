# SPDX licence expressions, evaluated against cmake/LicensePolicy.cmake (PF_ALLOWED_LICENSES,
# PF_ALLOWED_LICENSE_EXCEPTIONS). Used by check_licenses.cmake; tested by tests/license_policy_test.cmake.

# Splits EXPR at every top-level (not parenthesised) occurrence of OP (" OR " or " AND ").
function(pf_spdx_split expr op out_var)
    string(LENGTH "${expr}" len)
    string(LENGTH "${op}" op_len)
    set(parts "")
    set(depth 0)
    set(start 0)
    set(i 0)
    while(i LESS len)
        string(SUBSTRING "${expr}" ${i} 1 c)
        if(c STREQUAL "(")
            math(EXPR depth "${depth} + 1")
        elseif(c STREQUAL ")")
            math(EXPR depth "${depth} - 1")
        elseif(depth EQUAL 0)
            string(SUBSTRING "${expr}" ${i} ${op_len} candidate)
            if(candidate STREQUAL op)
                math(EXPR part_len "${i} - ${start}")
                string(SUBSTRING "${expr}" ${start} ${part_len} part)
                list(APPEND parts "${part}")
                math(EXPR i "${i} + ${op_len} - 1")
                math(EXPR start "${i} + 1")
            endif()
        endif()
        math(EXPR i "${i} + 1")
    endwhile()
    string(SUBSTRING "${expr}" ${start} -1 part)
    list(APPEND parts "${part}")
    set(${out_var} "${parts}" PARENT_SCOPE)
endfunction()

# Removes parentheses that enclose the whole expression: "(A OR B)" -> "A OR B".
function(pf_spdx_strip_parens expr out_var)
    string(STRIP "${expr}" expr)
    while(expr MATCHES "^\\(.*\\)$")
        string(LENGTH "${expr}" len)
        math(EXPR last "${len} - 1")
        set(depth 0)
        set(closes_at -1)
        set(i 0)
        while(i LESS len)
            string(SUBSTRING "${expr}" ${i} 1 c)
            if(c STREQUAL "(")
                math(EXPR depth "${depth} + 1")
            elseif(c STREQUAL ")")
                math(EXPR depth "${depth} - 1")
                if(depth EQUAL 0)
                    set(closes_at ${i})
                    break()
                endif()
            endif()
            math(EXPR i "${i} + 1")
        endwhile()
        if(NOT closes_at EQUAL last)
            break()
        endif()
        math(EXPR inner_len "${len} - 2")
        string(SUBSTRING "${expr}" 1 ${inner_len} expr)
        string(STRIP "${expr}" expr)
    endwhile()
    set(${out_var} "${expr}" PARENT_SCOPE)
endfunction()

# Sets OUT_VAR to TRUE when the SPDX expression is allowed by the policy. Precedence: WITH > AND > OR.
function(pf_spdx_allowed expr out_var)
    pf_spdx_strip_parens("${expr}" expr)
    pf_spdx_split("${expr}" " OR " alternatives)
    list(LENGTH alternatives count)
    if(count GREATER 1)
        foreach(alternative IN LISTS alternatives)
            pf_spdx_allowed("${alternative}" ok)
            if(ok)
                set(${out_var} TRUE PARENT_SCOPE)
                return()
            endif()
        endforeach()
        set(${out_var} FALSE PARENT_SCOPE)
        return()
    endif()
    pf_spdx_split("${expr}" " AND " terms)
    list(LENGTH terms count)
    if(count GREATER 1)
        foreach(term IN LISTS terms)
            pf_spdx_allowed("${term}" ok)
            if(NOT ok)
                set(${out_var} FALSE PARENT_SCOPE)
                return()
            endif()
        endforeach()
        set(${out_var} TRUE PARENT_SCOPE)
        return()
    endif()
    if(expr MATCHES "^([^ ]+) WITH ([^ ]+)$")
        set(license "${CMAKE_MATCH_1}")
        if(NOT CMAKE_MATCH_2 IN_LIST PF_ALLOWED_LICENSE_EXCEPTIONS)
            set(${out_var} FALSE PARENT_SCOPE)
            return()
        endif()
    else()
        set(license "${expr}")
    endif()
    if(license IN_LIST PF_ALLOWED_LICENSES)
        set(${out_var} TRUE PARENT_SCOPE)
    else()
        set(${out_var} FALSE PARENT_SCOPE)
    endif()
endfunction()
