{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-pf",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-pf",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux-pf" }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS debug (AddressSanitizer + UndefinedBehaviorSanitizer)",
      "inherits": ["base", "macos", "debug"],
      "cacheVariables": { "PF_SANITIZERS": "address;undefined" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS release",
      "inherits": ["base", "macos", "release"]
    },
    {
      "name": "windows-debug",
      "displayName": "Windows debug (AddressSanitizer)",
      "inherits": ["base", "windows", "debug"],
      "cacheVariables": { "PF_SANITIZERS": "address" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows release",
      "inherits": ["base", "windows", "release"]
    },
    {
      "name": "linux-debug",
      "displayName": "Linux debug (AddressSanitizer + UndefinedBehaviorSanitizer)",
      "inherits": ["base", "linux", "debug"],
      "cacheVariables": { "PF_SANITIZERS": "address;undefined" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux release",
      "inherits": ["base", "linux", "release"]
    }
  ],
  "buildPresets": [
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "macos-debug", "configurePreset": "macos-debug", "inherits": ["test-base"] },
    { "name": "macos-release", "configurePreset": "macos-release", "inherits": ["test-base"] },
    { "name": "windows-debug", "configurePreset": "windows-debug", "inherits": ["test-base"] },
    { "name": "windows-release", "configurePreset": "windows-release", "inherits": ["test-base"] },
    { "name": "linux-debug", "configurePreset": "linux-debug", "inherits": ["test-base"] },
    { "name": "linux-release", "configurePreset": "linux-release", "inherits": ["test-base"] }
  ]
}
