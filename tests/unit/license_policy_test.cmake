# Unit test of the licence-expression rules used by check-licenses (cmake/scripts/spdx.cmake). Run with cmake -P.

cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/LicensePolicy.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/scripts/spdx.cmake")

set(_failures "")
function(expect expr expected)
    pf_spdx_allowed("${expr}" actual)
    if(NOT actual STREQUAL expected)
        set(_failures "${_failures}\n  '${expr}': expected ${expected}, got ${actual}" PARENT_SCOPE)
    endif()
endfunction()

expect("MIT" TRUE)
expect("BSD-3-Clause" TRUE)
expect("GPL-2.0-only" FALSE)
expect("LGPL-2.1-or-later" FALSE)
expect("LicenseRef-vcpkg-null" FALSE)
expect("" FALSE)
expect("BSD-2-Clause AND BSD-3-Clause" TRUE)
expect("CC0-1.0 AND MIT" TRUE)
expect("0BSD" TRUE)
expect("MIT AND GPL-3.0-only" FALSE)
expect("(BSD-3-Clause OR GPL-2.0-only)" TRUE)
expect("GPL-2.0-only OR MIT" TRUE)
expect("GPL-2.0-only OR AGPL-3.0-only" FALSE)
expect("(MIT AND GPL-3.0-only) OR Apache-2.0" TRUE)
expect("(MIT AND GPL-3.0-only) OR GPL-2.0-only" FALSE)
expect("MIT AND (GPL-3.0-only OR BSD-3-Clause)" TRUE)
expect("Zlib AND (GPL-3.0-only OR AGPL-3.0-only)" FALSE)
expect("((MIT))" TRUE)
expect("(MIT) AND (GPL-2.0-only)" FALSE)
expect("Apache-2.0 WITH LLVM-exception" TRUE)
expect("GPL-2.0-only WITH Classpath-exception-2.0" FALSE)
expect("MIT OR GPL-2.0-only WITH Classpath-exception-2.0" TRUE)

if(_failures)
    message(FATAL_ERROR "licence policy test failed:${_failures}")
endif()
message(STATUS "licence policy test: all cases pass")
